{
  "name": "manifiest",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "codegen": "bunx panda codegen",
    "css": "bun run scripts/build-css.ts -i=pum/index.css -o=www/styles.css",
