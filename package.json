    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@pandacss/postcss": "^1.12.1",
    "@types/mithril": "^2.2.9",
    "autoprefixer": "^10.5.6",
    "cheerio": "^1.2.0",
    "cssnano": "^9.0.4",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lightningcss": "^1.33.0",
